# Settings for the CI-only targets.
#
# They live in this project's own `runfiles/`, so the directory name is the
# namespace, and that is the only name it has: `runfiles/ci/check.run` is `ci:check`.

ENV.CARGO_TERM_COLOR = "always"

# Cargo's default directory, pinned: the release workflows copy out of
# `target/<triple>/release/`, so a `CARGO_TARGET_DIR` a runner's environment
# sets must not move what they look for.
ENV.CARGO_TARGET_DIR = "target"
