# Run all workspace tests, then again with bash 3.2, macOS's own, as `bash` and `sh`
#
# As `test` does, and for the same reason: the Linux runners have bash 5 and
# nothing older, and three bugs got past them to the macOS leg. `_macos-bash`
# says where that bash comes from, and when there is no second pass.

let cargo = ENV.RUNFILE_CI_CARGO ? "cargo"

$ {{ cargo }} test --workspace --all-features --locked {{ ARGS }}

let shims = $ run _macos-bash

if shims != ""
	print("Again, with bash 3.2 as bash and sh, from {{ shims }}")

	do
		add_path(shims)

		# A pass that ran bash 5 again would pass, and say nothing: it once did.
		let found = $ command -v bash || true

		if found != "{{ shims }}/bash"
			error("bash 3.2: the second pass would run bash from `{{ found }}`, not {{ shims }}/bash")
		end

		$ {{ cargo }} test --workspace --all-features --locked {{ ARGS }}
	end
end
