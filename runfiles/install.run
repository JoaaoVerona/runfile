# Copy the built binaries to ~/.local/bin, replacing whatever is there
#
# Both of them, always. An editor talks to `runfile-lsp`, so a `run` newer than
# the language server beside it reports valid files as broken -- a `retry`, a
# `.logging`, a `case` label underlined in red while the runner accepts them.
# That happened three times before this target stopped installing only one.

run build-release

let ext = ""

if RUN.os == "windows"
	ext = ".exe"
end

for name in ["run", "runfile-lsp"]
	# Written beside the target and moved into place: `cp` onto a binary that
	# is running fails with "Text file busy", and the language server usually is.
	$ cp {{ ENV.CARGO_TARGET_DIR }}/release/{{ name }}{{ ext }} ~/.local/bin/.{{ name }}.new{{ ext }}
	$ mv -f ~/.local/bin/.{{ name }}.new{{ ext }} ~/.local/bin/{{ name }}{{ ext }}
end

print("Installed run and runfile-lsp to ~/.local/bin")
