# Copy the built binary to ~/.local/bin, replacing whatever is there
#
# One binary. The language server is `run :lsp`, so there is no second file to
# keep in step -- a `run` newer than the `runfile-lsp` beside it used to report
# valid files as broken, a `retry`, a `.logging`, a `case` label underlined in
# red while the runner accepted them. That happened three times.

run build-release

let ext = ""

if RUN.os == "windows"
	ext = ".exe"
end

# Written beside the target and moved into place: `cp` onto a binary that is
# running fails with "Text file busy", and an editor usually has one open.
$ cp {{ ENV.CARGO_TARGET_DIR }}/release/run{{ ext }} ~/.local/bin/.run.new{{ ext }}
$ mv -f ~/.local/bin/.run.new{{ ext }} ~/.local/bin/run{{ ext }}

print("Installed run to ~/.local/bin")
