# Bump the workspace version, tag the commit, and push so CI runs the release
#
# Takes one of major / minor / patch.
#
# Only the exact `vX.Y.Z` is pushed here. The `vX` alias that consumers of the
# setup action pin -- `…/actions/setup@v1` -- is moved by the release workflow
# once the release is built, since a tag meaning "the newest v1" must not point
# at a release that never finished.
#
# Which is why the tag is annotated and the push is `--follow-tags` rather than
# `--tags`. `--tags` pushes every local tag, and `vX` is one of them: a fetch
# auto-follows it once and then never updates it again, so the local copy sits
# at whatever release it was first seen at while CI force-moves the remote one
# forward. Pushing the stale copy is rejected -- `! [rejected] v1 -> v1
# (already exists)` -- and takes the release tag's push down with it.
# `--follow-tags` sends only annotated tags reachable from the commits being
# pushed, and the alias is lightweight, so it is exactly this one tag.

let part = one_of(first(ARGS), "major", "minor", "patch")
let cargo = read_file("Cargo.toml")

# A normal string, not a raw one: the pattern has no backslashes to preserve,
# and a raw string would be terminated by the first quote inside it.
let cur = regex_capture(cargo, "(?m)^version = \"([^\"]+)\"", 1)
let parts = split(cur, ".")
let major = number(parts[0])
let minor = number(parts[1])
let patch = number(parts[2])

let next = ""

match part
	case "major"
		next = concat(major + 1, ".0.0")
	case "minor"
		next = concat(major, ".", minor + 1, ".0")
	case "patch"
		next = concat(major, ".", minor, ".", patch + 1)
end

write_file("Cargo.toml", regex_replace(cargo, "(?m)^version = \"[^\"]+\"", concat("version = \"", next, "\"")))

$ cargo update --workspace
run _bump-vscode-extension {{ next }}

let tag = concat("v", next)

print("Bumped: {{ cur }} -> {{ next }}, tagging {{ tag }}")
$ git commit Cargo.toml Cargo.lock editors/vscode/package.json -m "bump to {{ next }}"
$ git tag -a {{ tag }} -m {{ tag }}
$ git push --follow-tags
