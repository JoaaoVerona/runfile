# Every control-flow shape

if ARG.env == "prod" && !FLAG.dry
	$ deploy
else
	$ echo skipped
end

for f in ["a", "b"]
	$ echo {{ f }}
end

match ARG.part
case "major"
	$ echo major
case "minor"
	$ echo minor
default
	error("unknown")
end

do
	.workdir = "web"

	$ pnpm install
end

if RUN.arch == "aarch64"
	$ echo arm
else if RUN.arch == "x86_64"
	$ echo intel
else
	$ echo other
end
