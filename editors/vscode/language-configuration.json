{
	"comments": { "lineComment": "#" },
	"brackets": [["[", "]"], ["(", ")"], ["{{", "}}"]],
	"autoClosingPairs": [
		{ "open": "\"", "close": "\"", "notIn": ["string"] },
		{ "open": "[", "close": "]" },
		{ "open": "(", "close": ")" }
	],
	"surroundingPairs": [["\"", "\""], ["[", "]"], ["(", ")"]],
	"indentationRules": {
		"increaseIndentPattern": "^\\s*(if\\b|else\\b|for\\b|while\\b|until\\b|loop\\b|do\\b|retry\\b|match\\b|case\\b|default\\b|exec\\b).*$",
		"decreaseIndentPattern": "^\\s*(end|else|case|default)\\b.*$"
	},
	"onEnterRules": [
		{
			"beforeText": "^\\s*#.*$",
			"action": { "indent": "none", "appendText": "# " }
		}
	]
}
