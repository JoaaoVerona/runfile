# Package and (re)install the extension into VSCodium (or VS Code if VSCodium is missing), replacing any existing copy

run package

let cli, editor = ["code", "VS Code"]

if $ command -v codium >/dev/null
	cli, editor = ["codium", "VSCodium"]
end

$ {{ cli }} --install-extension runfile-vscode.vsix --force
print("Installed — run \"Developer: Reload Window\" in {{ editor }} to activate.")
