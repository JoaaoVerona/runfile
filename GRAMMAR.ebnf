(* Runfile .run — grammar v0 *)

file        = { line } ;
line        = blank | property | exec_block | shell | ( WS , statement , eol ) ;

blank       = WS , [ comment ] , NEWLINE ;
(* Every line this language reads ends this way. `shell` is the exception: the
   text after `$ ` is the shell's, `#` and all, and no lexer of this language
   can quote-scan another's. An `exec` *command* does end this way, because the
   runner reads that line itself -- it splits it into words and spawns the
   program -- while the body below it does not. *)
eol         = [ comment ] , NEWLINE ;
(* A `#` opens a comment only where it begins a *word*: at the start of a line,
   or after a blank. That is a rule about the character before it, so the lexer
   states it and this grammar cannot. It is the shell's own rule, which is what
   makes one sentence true on both sides of the marker: `a#b` is one word in
   either half. A `#` inside a string or a `{{ … }}` is text -- the only way to
   write a word that does begin with one. *)
comment     = "#" , { ANY - NEWLINE } ;

(* ---- properties ---- *)
property    = WS , "." , ident , { "." , ident } , [ WS , "=" , WS , expr ] , eol ;
(* A property describes the whole file, so it is written at its top, above the first statement; one inside a
   block, or below a statement, is refused -- a rule about where a line sits, which the parser states and this
   grammar cannot. `.shell`, `.logging`, `.watch` and `.only-in-directories` are the ones there are:
   `PROPERTIES` in runfile-runtime is the list. *)

(* ---- shell ---- *)
shell       = WS , [ "detach" , " " ] , "$" , " " , shell_text , NEWLINE ;  (* no comment: all of it is the shell's *)
(* `detach` starts the command and does not wait. It marks one command: a `detach $` line is its own
   statement, where contiguous plain `$` lines are folded into a single process. It is a marker only in
   front of `$` and `exec`, so `detach = 5` is an ordinary reassignment, and `detach run` is refused --
   a dispatch happens in this process and has none to detach. *)
shell_text  = { ANY - NEWLINE | "\" , NEWLINE } ;          (* backslash continues *)

exec_block  = WS , [ "detach" , " " ] , "exec" , " " , cmd_text , eol ,
              { ANY - ( WS , "end" , eol ) } ,
              WS , "end" , eol ;
(* The words of a command line, which is how the runner splits it -- so a `#`
   beginning one of them is a comment here, unlike in `shell_text`. *)
cmd_text    = cmd_word , { WS , cmd_word } ;
cmd_word    = ( ANY - WS - NEWLINE - "#" | interp ) , { ANY - WS - NEWLINE | interp } ;

(* ---- statements ---- *)
statement   = let | assign | set_env | if | else | for | while | until | loop
            | break | continue | match | case | default
            | run | retry | do | end | call ;

let         = "let" , names , "=" , value ;
assign      = names , "=" , value ;
(* One name binds the value whole; several unpack a list positionally, and a
   name with nothing to bind is an error. `_` is a position matched and thrown
   away, and may be repeated -- it is not an ident, so it shadows nothing. *)
names       = ( ident | "_" ) , { "," , ( ident | "_" ) } ;
(* `ENV` is the one source a file may set; `ARG.x`, `FLAG.x`, `RUN.x` and `ARGS` on the left are refused as
   read-only. What it sets lasts past the block it is written in, as a `let` does, until a `do` puts it back. *)
set_env     = "ENV" , "." , ident , "=" , value ;
if          = "if" , ( expr | capture ) ;                   (* `if $ cmd` is true when it succeeds *)
else        = "else" , [ "if" , ( expr | capture ) ] ;      (* a chain of them is one block, closed by one `end` *)
for         = [ "parallel" ] , "for" , names , "in" , ( expr | capture ) ;
while       = "while" , ( expr | capture ) ;                (* again while it holds *)
until       = "until" , ( expr | capture ) ;                (* again while it does not *)
loop        = "loop" ;                                      (* again forever; `break` is how it ends *)
(* Refused outside a `for`, `while`, `until` or `loop` -- a rule about where a
   line sits rather than about its shape, so the parser states it and this
   grammar cannot. *)
break       = "break" ;
continue    = "continue" ;
match       = "match" , ( expr | capture ) ;                (* over a capture, the cases are exit codes *)
case        = "case" , string ;                             (* a label is a value, so it is quoted *)
default     = "default" ;
retry       = "retry" , number , [ "every" , number ] ;
do          = [ "parallel" ] , "do" ;                       (* a block that puts the run's state back at its `end` *)
(* `parallel do` makes each statement directly inside it a branch, and `parallel for` each iteration; the
   branches run at once. `parallel` is a marker only in front of `do` and `for`, so `parallel = 5` is an
   ordinary reassignment. What the parser refuses inside one is a rule about where a line sits, which this
   grammar cannot state: a `let` directly inside `parallel do`, assigning a name the branch did not bind,
   `break` or `continue` reaching a loop outside the block, `break` ending a `parallel for`, and an
   `ENV.X =` or an effect call directly inside `parallel do`, which would change a copy nobody reads. Each `$`
   line directly inside `parallel do` is its own branch rather than folded into the next. *)
end         = "end" ;
run         = "run" , target_ref , { WS , arg_word } ;
call        = postfix | capture_call ;                      (* bare call, e.g. decrypt(a,b) *)
(* `set_cwd`, `add_path`, `import_env_file` and `ignore_errors` change the state every line below runs in, and
   are refused anywhere but as a `call` of their own. `ignore_errors()` may only sit directly in the file's
   block or a plain `do`'s -- rules about where a line sits, which the parser states and this grammar cannot. *)
(* A call names a function the language has, and an `ident` read as a value names a binding some line before
   it can have made -- by the runner's scoping rather than by shape, so neither is stated here. Both are
   checked once a file has parsed and before any of it runs (`runfile-lang/src/resolve.rs`), and a
   reassignment needs a `let` of its name above it. *)

target_ref  = { ident_char | ":" | interp } | package_ref ;
arg_word    = { ANY - WS - NEWLINE | interp } ;
(* A word with a `/` names a package, whose `runfiles/_main.run` is what runs -- no target's name can hold
   one, a `:` standing where its directories were. A folder on disk is a path; a repository is its host, then
   `owner/repo` (or a path ending in `.git`, for a GitLab subgroup), then a folder inside it, and always a
   version: a tag, a branch, or a full commit id. `http://` and ssh addresses are refused, as is a reference
   with no version -- by the checker before a run (`package-reference`), and by the runner for one built at
   run time. *)
package_ref = path_ref | [ "https://" ] , host , "/" , segment , "/" , segment , { "/" , segment } , "@" , version ;
path_ref    = "." | ".." | ( "./" | "../" | "/" ) , { ANY - WS - NEWLINE } ;
host        = label , { "." , label } , [ ":" , digit , { digit } ] ;   (* at least one `.` *)
segment     = { letter | digit | "." | "_" | "-" | "~" | "+" } ;
version     = { ANY - WS - NEWLINE } ;                       (* a name `git check-ref-format` accepts *)

(* ---- values ---- *)
(* A capture or a structured block stands where a value is wanted. Each ends at
   a boundary a line-oriented grammar cannot state: a `$` capture at the
   newline, an `exec` or structured body at an `end` at its *opener's*
   indentation. *)
value       = expr | capture | structured | capture_call ;
capture     = "$" , " " , shell_text
            | "exec" , " " , cmd_text , eol , exec_body , WS , "end" ;
structured  = struct_kw , eol , exec_body , WS , "end" ;
struct_kw   = "json" ;
exec_body   = { ANY - ( WS , "end" , eol ) } ;              (* a `#` in a body is that language's *)

(* A call whose last argument is a `$` run: the capture reaches the `)`, which
   has to be the last character of the line. `code_of` is the one call that may
   take a `run` dispatch or an `exec` program instead — a dispatched target, and
   a program given the terminal, report a status, not output, so a status is the
   only value either has to give. A program's command is split by the runner, as
   an `exec` block's is, and holds no `)` outside an interpolation. *)
capture_call = ident , "(" , { expr , "," } , ( "$" , " " , shell_text | dispatch | program ) , ")" ;
dispatch    = "run" , target_ref , { WS , arg_word } ;
program     = "exec" , " " , cmd_text ;

(* ---- expressions ---- *)
expr        = chain ;
chain       = or , { "?" , or } ;                           (* fallback *)
or          = and , { "||" , and } ;
and         = cmp , { "&&" , cmp } ;
cmp         = add , { ( "==" | "!=" | "<" | "<=" | ">" | ">=" ) , add } ;
add         = mul , { ( "+" | "-" ) , mul } ;
mul         = unary , { ( "*" | "/" | "%" ) , unary } ;
unary       = [ "!" | "-" ] , postfix ;
postfix     = primary , { "[" , expr , "]" | "(" , [ arglist ] , ")" } ;
arglist     = expr , { "," , expr } , [ "," ] ;
primary     = number | string | rawstring | bool | list | source | ident
            | "(" , expr , ")" ;

list        = "[" , [ expr , { "," , expr } , [ "," ] ] , "]" ;   (* may span lines; an element is any expr, so lists nest *)
source      = ( "ARG" | "ENV" | "FLAG" | "RUN" ) , "." , ident | "ARGS" ;
bool        = "true" | "false" ;
number      = digit , { digit } , [ "." , digit , { digit } ] ;
string      = '"' , { str_char | interp } , '"' ;
rawstring   = 'r"' , { ANY - '"' | interp } , '"' ;
str_char    = ( ANY - '"' - "\" ) | "\" , ( '"' | "\" | "n" | "t" | "r" | "e" ) ;   (* `\e` is ESC *)
interp      = "{{" , WS , expr , WS , "}}" ;
ident       = letter , { letter | digit | "_" | "-" } ;
